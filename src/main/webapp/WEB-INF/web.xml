<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

  <display-name>gestion-estudiantes</display-name>

  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

  <servlet>
    <servlet-name>consultaServlet</servlet-name>
    <servlet-class>net.elpuig.daw2.servlets.ConsultaServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>consultaServlet</servlet-name>
    <url-pattern>/consulta</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>Report</servlet-name>
    <servlet-class>net.elpuig.daw2.servlets.Report</servlet-class>
    <async-supported>true</async-supported>
  </servlet>

  <servlet-mapping>
    <servlet-name>Report</servlet-name>
    <url-pattern>/informe</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ImageServlet</servlet-name>
    <servlet-class>net.sf.jasperreports.j2ee.servlets.ImageServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>ImageServlet</servlet-name>
    <url-pattern>/image</url-pattern>
  </servlet-mapping>

  <!-- Servlet Controlador -->
  <servlet>
    <servlet-name>Controlador</servlet-name>
    <servlet-class>net.elpuig.daw2.servlets.Controlador</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Controlador</servlet-name>
    <url-pattern>/Controlador</url-pattern>
  </servlet-mapping>

  <!-- Servlet Login -->
  <servlet>
    <servlet-name>Login</servlet-name>
    <servlet-class>net.elpuig.daw2.servlets.Login</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Login</servlet-name>
    <url-pattern>/Login</url-pattern>
  </servlet-mapping>

  <!-- Listener de sesiones -->
  <listener>
    <listener-class>net.elpuig.daw2.listener.WebSessionListener</listener-class>
  </listener>

  <!-- Timeout de sesión: 15 minutos -->
  <session-config>
    <session-timeout>15</session-timeout>
  </session-config>
</web-app>
