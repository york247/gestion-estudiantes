<jasperReport xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Alumnos" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <queryString language="SQL">
        SELECT alumnos.`id` AS alumnos_id, alumnos.`curso` AS alumnos_curso, alumnos.`nombre` AS alumnos_nombre FROM `alumnos` alumnos
